{
  "name": "llm-session-share",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORT=${PORT:-8789} tsx watch server/src/node.ts",
    "build": "esbuild server/src/node.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/node.js",
    "start": "node dist/node.js",
    "check": "tsc --noEmit",
    "test": "tsx --test server/test/*.test.ts",
    "worker:dev": "wrangler dev",
    "worker:check": "wrangler deploy --dry-run --outdir work/worker",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.2.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.141.0"
  }
}
